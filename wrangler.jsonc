{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Legacy name: this Worker currently serves the production custom domain.
  // Do not rename it until Cloudflare routing is migrated deliberately.
  "name": "gebcalc-staging",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    {
      "pattern": "e-rechnung.top4reinigung.de",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://squkjqvofugkanzuqtqn.supabase.co",
    "PUBLIC_SITE_URL": "https://e-rechnung.top4reinigung.de",
    "RESEND_FROM": "GebCalc <info@top4reinigung.de>"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "gebcalc-staging-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "PUBLIC_SITE_URL": "https://gebcalc-staging-preview.workers.dev",
        "RESEND_FROM": "GebCalc Staging <info@top4reinigung.de>"
      }
    }
  }
}
