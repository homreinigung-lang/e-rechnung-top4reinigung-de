# Client-safe Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional temporary fallback while migrating old deployments:
SUPABASE_SERVICE_ROLE_KEY=

# Email (server-only)
RESEND_API_KEY=
RESEND_FROM=

# AI provider (server-only; provider finalized after accuracy comparison)
GEMINI_API_KEY=

# Public application URL used for auth/email redirects
PUBLIC_SITE_URL=

# Cron endpoint authentication (preferred: SHA-256 hex of the secret)
CRON_SECRET_SHA256=
# Temporary compatibility only; prefer CRON_SECRET_SHA256.
CRON_SECRET=

# Stripe: off by default. Sandbox requires an isolated deployment and database.
STRIPE_BILLING_MODE=off
STRIPE_LIVE_ENABLED=false
STRIPE_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_LIVE_TAX_RATE_ID=
STRIPE_LIVE_PRICES={}
STRIPE_SANDBOX_TAX_RATE_ID=
